PORT=23669

# Path to SillyTavernchat DATA_ROOT. Use an absolute path like
# /root/SillyTavernchat/data in production, or a path relative to the
# working directory where you start this service (typically dmsystem/).
DATA_ROOT=../data

# Temporary root for this upload system (uploads, extracts, upload backups).
# In production you can set it to /root/dmsystem/temp or any other location.
DMSYSTEM_TEMP_ROOT=./temp

# Session secret for express-session
SESSION_SECRET=please-change-me

# LinuxDo OAuth2 client configuration
# Prefer LINUXDO_* variables; CLIENT_ID/CLIENT_SECRET/REDIRECT_URI are kept
# for compatibility with existing deployment notes.
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=https://data.pixcora.com/oauth

CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://data.pixcora.com/oauth

LINUXDO_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_USERINFO_URL=https://connect.linux.do/api/user

# Admin credentials for /admin backend (independent of LinuxDo login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
